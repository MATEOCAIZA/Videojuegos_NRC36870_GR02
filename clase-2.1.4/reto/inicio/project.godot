; Proyecto educativo del grupo 2
config_version=5

[application]
config/name="Grupo 2 - Inspector de InputEvent"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.11, 1)
